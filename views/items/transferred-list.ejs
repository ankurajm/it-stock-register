<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-building text-primary me-2"></i>Transferred Assets</h4>
            <p class="text-muted mb-0"><%= totalItems %> item(s) transferred to other schools</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/reports/transferred/pdf" class="btn btn-outline-danger btn-sm" target="_blank">
                <i class="bi bi-file-pdf me-1"></i> PDF
            </a>
            <a href="/reports/transferred/excel" class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-excel me-1"></i> Excel
            </a>
            <a href="/items" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> All Items
            </a>
        </div>
    </div>

    <% if (items.length === 0) { %>
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-building display-4 text-muted"></i>
            <h5 class="mt-3">No Transferred Assets</h5>
            <p class="text-muted">No assets have been transferred to other schools yet.</p>
            <a href="/items" class="btn btn-primary btn-sm">View All Items</a>
        </div>
    </div>
    <% } else { %>
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Asset Tag</th>
                        <th>Category</th>
                        <th>Brand / Model</th>
                        <th class="d-none d-md-table-cell">Serial No.</th>
                        <th>Transfer Date</th>
                        <th>Destination School</th>
                        <th class="d-none d-lg-table-cell">Received By</th>
                        <th class="d-none d-lg-table-cell">Transferred By</th>
                    </tr>
                </thead>
                <tbody>
                    <% items.forEach(function(item) { %>
                    <tr>
                        <td>
                            <a href="/items/view/<%= item.item_id %>" class="text-decoration-none fw-bold">
                                <%= item.asset_tag %>
                            </a>
                        </td>
                        <td><span class="badge bg-primary"><%= item.category %></span></td>
                        <td><%= item.brand || '' %> <%= item.model || '' %></td>
                        <td class="d-none d-md-table-cell"><code class="small"><%= item.serial_number || '-' %></code></td>
                        <td><%= item.disposal_date ? new Date(item.disposal_date).toLocaleDateString('en-IN') : '-' %></td>
                        <td><strong><%= item.destination_school || '-' %></strong></td>
                        <td class="d-none d-lg-table-cell"><%= item.received_by || '-' %></td>
                        <td class="d-none d-lg-table-cell"><%= item.created_by_name || '-' %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <% if (totalPages > 1) { %>
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage - 1 %>">Previous</a>
            </li>
            <% for (let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= p %>"><%= p %></a>
            </li>
            <% } %>
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
            </li>
        </ul>
    </nav>
    <% } %>
    <% } %>
</div>
